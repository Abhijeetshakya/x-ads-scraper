      },
      "country": {
        "type": "string",
        "description": "ISO alpha-2 country where this ad was served."
      },
      "countryName": {
        "type": [
          "string",
          "null"
        ],
        "description": "ISO regional display name."
      },
      "countryNameSource": {
        "type": "string",
        "description": "ISO/Intl derived country name or unknown."
