      "targetedLocationsStatus": {
        "type": "string",
        "description": "Whether geo-targeting was actually disclosed."
      },
      "targetingStatus": {
        "type": "string",
        "description": "Whether targeting was actually disclosed."
      },
      "targetingSummary": {
        "type": "string",
        "description": "Human-readable targeting string suitable for CSV."
      },
      "impressionsStatus": {
        "type": "string",
        "description": "Repository count or aggregation/unknown reason."
      },
      "reachStatus": {
        "type": "string",
        "description": "Repository reach or non-additive multi-chunk reason."
      },
      "fundingStatus": {
        "type": "string",
        "description": "Disclosed funding coverage; missing nested fields carry availability reasons."
      },
      "approvalStatus": {
        "type": [
          "string",
          "null"
        ],
        "description": "Source approval status preserved as disclosed."
