        "type": "string",
        "description": "Repository ad identifier, or the tweet ID when no ad identifier is disclosed."
      },
      "adIdSource": {
        "type": "string",
        "description": "repository or tweet_id_fallback."
      },
      "tweetId": {
        "type": "string",
        "description": "Post ID preserved exactly as a string, never floating point."
      },
      "lineItemId": {
        "type": "string",
        "description": "Disclosed advertising line-item ID."
      },
      "accountId": {
        "type": [
          "string",
          "null"
        ],
        "description": "Disclosed advertising account ID; not necessarily the public user ID."
      },
      "adName": {
        "type": "string",
        "description": "Derived name, never represented as a disclosed X campaign title."
      },
      "adNameSource": {
        "type": "string",
        "description": "Name derivation: UTM campaign/content, creative headline, or identity."
      },
      "adUrl": {
        "type": "string",
        "description": "Public post link."
      },
      "adCreatedAt": {
        "type": [
          "string",
          "null"
        ],
        "description": "UTC post creation from Snowflake arithmetic, not campaign delivery start."
      },
      "adCreatedAtSource": {
        "type": "string",
        "description": "derived_tweet_snowflake or invalid_or_pre_snowflake_id."
      },
      "deliveryStart": {
        "type": [
          "string",
          "null"
        ],
        "description": "Disclosed delivery start, otherwise null; query window is not substituted."
