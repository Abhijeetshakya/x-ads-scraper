{
  "name": "x-twitter-ads-scraper",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --import tsx src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "test": "vitest run --exclude test/e2e.test.ts --exclude test/live.test.ts --exclude test/ui-browser.test.ts",
    "test:browser": "vitest run test/ui-browser.test.ts",
    "test:e2e": "vitest run test/e2e.test.ts",
    "test:live": "vitest run test/live.test.ts",
    "check": "npm run typecheck && npm run lint && npm test && npm run test:e2e && APIFY_CLI_DISABLE_TELEMETRY=1 apify validate-schema",
    "demo": "node --import tsx scripts/demo.ts"
  },
  "dependencies": {
    "apify": "3.7.2",
    "csv-parse": "^6.1.0",
    "csv-stringify": "^6.6.0",
    "exceljs": "4.4.0",
    "cheerio": "^1.1.2",
    "json-bigint": "^1.0.0",
    "playwright": "^1.55.0",
    "re2-wasm": "^1.0.2",
    "undici": "^7.16.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/json-bigint": "^1.0.4",
    "@eslint/js": "^9.39.0",
    "apify-cli": "1.10.0",
    "eslint": "^9.39.0",
    "typescript-eslint": "^8.46.0",
    "typescript": "^5.9.0",
    "tsx": "^4.20.0",
    "vitest": "^3.2.4"
  }
}
